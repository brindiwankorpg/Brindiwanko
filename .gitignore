node_modules/
dist/
public/build/
data/*.db
data/*.db-*
# Files left by a restoration (the previous database, the pending one...).
data/*.db.*
uploads.before-restore/
uploads.failed-restore/
data/backups/
# A database given by DB_PATH as a path relative to the project folder (e.g. DB_PATH=game.db), with its side
# files and its backups: they hold e-mail addresses and password hashes, never to be committed.
/*.db
/*.db-*
/*.db.*
/backups/
uploads/*
!uploads/.gitkeep
step.txt
# Working notes and reports (TEST-REPORT.md...), but not the documentation.
*.md
!README.md
!/CHANGELOG.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/docs/**/*.md
!/.github/**/*.md
# Working files of a session with an assistant (scripts, reports).
scratch/
/rapport*.html

# E2E test accounts
tests/e2e-accounts.local.txt
# Screenshots of browser test campaigns
qa-evidence/
fix.txt
